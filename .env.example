# =========================================================
# CITADEL SYSTEM LOGISTICAL ENVIRONMENT CONFIGURATION KEYS
# =========================================================
# Copy this file to .env before starting Citadel (install.sh does this for you
# automatically if .env doesn't already exist).

# Which optional modules `docker compose up -d` (no --profile flag)
# actually starts -- see docker-compose.yml's own top-of-file comment
# for how this works. Every module is listed by default so a plain
# `docker compose up -d` starts everything, the same as before modules
# had profiles at all. For a lighter install (e.g. a Raspberry Pi),
# replace this with just the modules you want, e.g.:
#   COMPOSE_PROFILES=vigil,notes,knowledge
# Module names -> cockpit card: vigil=Home Monitor Matrix,
# ai=Offline AI Assistant, knowledge=Knowledge Base, notes=Secure Notes,
# audio=Whisper transcription (used by Mealie's Audio Provider),
# education=Cloud9 + Kolibri, recipes=Mealie.
#
# Two profiles are deliberately NOT in the default list below, both
# needing real hardware passed through -- add them yourself only once
# you actually have the device: `hardware` (RTL-SDR dongle, trunked
# radio scanner) and `camera` (a real webcam, /dev/video0, for Project
# IBRIS's motion detector reporting into Vigil's tripline).
COMPOSE_PROFILES=vigil,ai,knowledge,notes,audio,education,recipes

# The real absolute path Citadel is installed at on THIS machine.
# install.sh/install.bat write this automatically every run (even on an
# existing install, in case the folder moved) -- you shouldn't need to
# set it by hand. It's what lets vault-api's Settings > Modules
# "one-click apply" actually run `docker compose up -d` for you: see
# docker-compose.yml's comment on vault-api's volumes for why a
# Docker-outside-of-Docker mount needs this exact path on both sides.
# Leave blank (or missing) and that one feature just tells you to run
# `docker compose up -d` yourself instead -- nothing else depends on it.
CITADEL_HOST_PATH=

# =========================================================
# TACTICAL MAP STATION MARKER (map.html) -- optional, purely cosmetic.
# Leave unset for a generic placeholder marker; fill in your own real
# call sign/location/grid/coordinates if you want the map to show your
# actual station. This is real personal info -- it belongs here in your
# own .env (gitignored, never committed), never hardcoded into map.html
# itself or any other file that gets committed to a repo you might share
# or push publicly.
# =========================================================
STATION_CALLSIGN=
STATION_LOCATION=
STATION_GRID=
STATION_LAT=
STATION_LON=

# Where Kiwix looks for offline .zim wiki archives. Defaults to a folder inside
# this project — drop your own .zim files there, or point this at wherever you
# keep them. The leading `../../` is deliberate, not a typo -- this path is
# read by modules/knowledge/compose.fragment.yml (ROADMAP.md Phase B module
# system), and Docker Compose resolves relative paths in an `include`-d file
# relative to THAT file's own directory -- modules/knowledge/ is two levels
# under the repo root, not one, so it takes two `../` to get back to it (
# confirmed empirically with `docker compose config`, not assumed). An
# absolute path here (if you point this somewhere outside the project) is
# unaffected by any of this.
KIWIX_STORAGE_PATH=../../appdata/kiwix-library

# Internal System Environment Port Defaults
# Host-side port only — the container still listens on 11434 internally. If you
# already run Ollama natively on this machine (e.g. via snap/homebrew), that
# service will already own port 11434, so Citadel's own Ollama container is
# mapped to 11500 instead to avoid a conflict. Change this if 11500 is also taken.
OLLAMA_PORT=11500
COCKPIT_PORT=8085

# =========================================================
# CITADEL OFFLINE KOLIBRI HOME SCHOOL CONFIGURATION KEYS
# =========================================================
KOLIBRI_PORT=8081
# Same `../../` note as KIWIX_STORAGE_PATH above -- resolved relative to
# modules/education/compose.fragment.yml, two levels under the repo root.
KOLIBRI_DATA_PATH=../../appdata/kolibri_home

# =========================================================
# CLOUD9 KID DASHBOARD CONFIGURATION KEYS
# =========================================================
CLOUD9_PORT=8099

# =========================================================
# MEALIE RECIPE MANAGER / MEAL PLANNER CONFIGURATION KEYS
# =========================================================
MEALIE_PORT=8097

# Generate this from inside Mealie after your first login (User Settings
# -> API Tokens) and paste it here, then `docker compose up -d vault-api`
# to pick it up. It lets vault-api's /api/pantry-check bridge call
# Mealie's own API server-to-server to cross-check a recipe's ingredient
# list against your Food Inventory / Freezer Foods ledgers. Leave blank
# until you've done that -- pantry-check just returns a clear error
# telling you so instead of failing silently.
MEALIE_API_TOKEN=
