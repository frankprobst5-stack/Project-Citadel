# Real per-install config — install.sh generates this from .env.example.
# Never commit an actual .env even though this project's values aren't
# secrets (just ports/paths) — the convention matters more than this
# specific file's contents.
.env

# Generated at cockpit container startup from .env's COMPOSE_PROFILES
# (see docker-compose.yml's cockpit service) -- an environment-derived
# artifact, not source, and it lands on the host because appdata/cockpit
# is bind-mounted into the container.
appdata/cockpit/modules-enabled.json

# Same as above, generated from .env's STATION_* variables -- holds the
# real call sign/town/grid/coordinates, so this must never be committed.
appdata/cockpit/station-config.json

# Real runtime output of scripts/health-check.sh -- generated on this
# host each time the timer fires, not source.
appdata/health-check-status.json

# Packaged distributable — not source, regenerate from the repo instead.
citadel.zip

# Real backup archives (created via Settings -> Backups) -- contain
# most of appdata/ plus .env (API tokens, real station location), never
# belongs in git regardless of how the rest of appdata/ is handled.
backups/

# Runtime data every bundled service writes into appdata/ once running —
# none of this belongs in git (media libraries, model weights, chat
# history, encyclopedia archives, etc. are all real user data, not code).
appdata/ollama/
appdata/whisper-models/
appdata/open-webui/
appdata/flatnotes/
appdata/kolibri_home/
appdata/kiwix/
appdata/kiwix-library/
appdata/media-vault/videos/
appdata/media-vault/mp3s/
appdata/media-vault/pdfs/
appdata/media-vault/notes-data/
appdata/media-vault/citadel.db

# Mealie's real data: the household's actual recipes/photos, a user
# profile picture, and Mealie's own auth session secrets (.secret,
# .session_secret) -- same reasoning as every other appdata/ real-data
# exclusion above, never belongs in git.
appdata/mealie/data/
appdata/media-vault/ZIM_Library/
appdata/project-vigil/vigil_state.json
appdata/project-vigil/vigil_grid_ledger.json

# Cloud9 -- same reasoning as every other real-data exclusion above. The
# 1.1GB Qwen model exceeds GitHub's 100MB limit regardless; the NLTK
# corpus is fetched data, not source; the rest is real kid-generated
# content (journal/planner/scratchpad/etc.) that ships blank upstream and
# gets regenerated on first real use, matching the Cloud9 repo's own
# .gitignore for these same files.
appdata/cloud9/models/*.gguf
appdata/cloud9/data/nltk_data/
appdata/cloud9/data/settings.json
appdata/cloud9/data/journal_entries.json
appdata/cloud9/data/planner_notes.json
appdata/cloud9/data/scratchpad.json
appdata/cloud9/data/writing_paper.json
appdata/cloud9/data/videos.json
appdata/cloud9/server/static/videos/
# Real runtime SQLite caches (weather/storm/sounding/model-lab/school
# library/interactivity), same reasoning as the JSON data files above --
# regenerated on first real use, never source.
appdata/cloud9/data/*.db

# Personal SDR channel configs — reveals real county/location names, not
# generic sample data. Never belongs in a public repo.
appdata/media-vault/SDRUno/

# Empty scaffolding / not-yet-wired staging dirs (see ROADMAP.md Phase 2
# and Phase 5) — nothing real in them yet, exclude until they hold actual
# source or the roadmap items they're staged for get built.
appdata/notes/
appdata/project-intercept/
appdata/project-ibris/
appdata/cockpit/media/
appdata/cockpit/project-vigil/

# Scanner-decode and local-weather-capture state, once a real daemon writes
# it (see /api/scanner, /api/weather in media-vault/app.py) — real captured
# audio/transcripts/observations are user data, same reasoning as every
# other appdata/ runtime-data exclusion above, not staged/empty like the
# scaffolding dirs but still never belongs in git.
appdata/media-vault/scanner/
appdata/media-vault/weather/
appdata/media-vault/intercept/

# WayStation basemap tiles — 300MB+ of binary map data, not source, and
# tactical_terrain.pmtiles alone exceeds GitHub's 100MB file limit.
# Provision separately (install script / release asset), never via git.
appdata/cockpit/tiles/

# Generated at cockpit container startup from .env's VAULT_API_TOKEN
# (see docker-compose.yml's cockpit command) -- a real per-install
# secret, same reasoning as .env itself never being committed.
appdata/cockpit/vault-token.json

# Python bytecode cache
__pycache__/
*.pyc
.pytest_cache/

# Standard OS cruft
.DS_Store
Thumbs.db
